<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Daedalus" Manufacturer="AraneaDev" Version="$(Version)"
           UpgradeCode="3E5E2423-624C-4A96-80BD-F9C3A1310FAE" Scope="perMachine">
    <Icon Id="Daedalus.exe" SourceFile="packaging/daedalus.ico" />
    <Property Id="ARPPRODUCTICON" Value="Daedalus.exe" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Daedalus is already installed." />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Daedalus">
        <Component Id="Workbench" Guid="*">
          <File Id="Ui" Source="target/release/daedalus-ui.exe" KeyPath="yes">
            <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Daedalus" Advertise="no" Icon="Daedalus.exe" Description="Open the Daedalus workbench" />
          </File>
        </Component>
        <Component Id="Daemon" Guid="*"><File Source="target/release/daedalusd.exe" /></Component>
        <Component Id="Control" Guid="*">
          <File Source="target/release/daedalus-ctl.exe" KeyPath="yes" />
          <Environment Id="AddPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Complete" Title="Daedalus" Level="1">
      <ComponentRef Id="Workbench" /><ComponentRef Id="Daemon" /><ComponentRef Id="Control" />
    </Feature>
  </Package>
</Wix>
